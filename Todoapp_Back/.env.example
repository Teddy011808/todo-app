# Copy this file to .env and change the values for your machine.

# API (set CORS_ORIGIN=http://your-site to allow only one origin)
PORT=3000

# PostgreSQL (matches docker-compose.yml)
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=todo

# RabbitMQ (matches docker-compose.yml)
RMQ_URL=amqp://localhost:5672
# Worker only: pause before each email. 5000 for the Unacked and crash tests
EMAIL_DELAY_MS=0

# Signs login tokens. Use a long random value: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-32-chars-min
